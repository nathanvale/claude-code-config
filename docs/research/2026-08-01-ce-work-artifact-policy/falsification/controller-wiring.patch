+    if lock:
+        cmd_integration_release(_args(run_id=args.run_id, unit_id=lock["unit_id"], lock_token=lock["nonce"]))
+        released = True
+    return "ARTIFACT_RESUMED", {
+        "transactions": results,
+        "orphan_custody_removed": orphans,
+        "integration_lock_released": released,
+    }
