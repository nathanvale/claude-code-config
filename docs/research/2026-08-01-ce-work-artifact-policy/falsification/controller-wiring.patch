+    tmp = os.path.join(parent, f".artifact-phase-{secrets.token_hex(6)}.tmp")
+    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | O_NOFOLLOW, 0o600)
+    try:
+        data = (json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n").encode()
+        os.write(fd, data)
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+    os.replace(tmp, path)
