+def cmd_artifact_resume(args) -> tuple[str, dict]:
+    """Resume interrupted artifact transactions: restore precious custody from the
+    durable phase record, emit exactly one truthful receipt, release the lock.
+    Never deletes state outside controller-private directories."""
+    with locked_manifest(args.run_id) as doc:
+        validate_repo(doc)
+        repo = doc["repository"]["toplevel"]
+        verifications = list(doc.get("verifications", []))
+    jobs = os.path.join(run_dir(args.run_id), "jobs")
+    validate_private_dir(jobs)
+    results = []
+    referenced_roots: set[str] = set()
+    for name in sorted(os.listdir(jobs)):
+        if not name.startswith("artifact-phase-") or not name.endswith(".json"):
+            continue
+        path = os.path.join(jobs, name)
+        record = json.loads(Path(path).read_bytes())
+        tid = record["transaction_id"]
+        referenced_roots.add(record["custody"]["root"])
+        if record["phase"] == "complete":
+            results.append({"transaction_id": tid, "action": "already-complete"})
+            continue
+        receipted = any(v.get("attempt_id") == tid for v in verifications)
+        custody = _custody_from_record(repo, record["custody"])
+        if receipted:
+            custody.close()
+            record["phase"] = "complete"
+            _write_phase_record(path, record)
+            results.append({"transaction_id": tid, "action": "finalized-after-receipt"})
+            continue
+        policy = _policy_from_document(repo, record["policy"])
+        artifact = _artifact_settle(repo, policy, record, custody, None)
+        if artifact["precious_restoration_errors"]:
+            results.append({
+                "transaction_id": tid,
+                "action": "restoration-blocked",
+                "errors": artifact["precious_restoration_errors"],
+            })
+            continue
+        receipt = {
+            "attempt_id": tid,
+            "at": now_iso(),
+            "argv": record.get("argv"),
+            "summary": "resumed after interruption; artifact custody settled, verification result unknown",
+            "verification_exit": None,
+            "canonical_head": None,
+            "resumed": True,
+            "artifact": artifact,
+        }
+        receipt["evidence_digest"] = digest_bytes(
+            json.dumps(receipt, sort_keys=True, separators=(",", ":")).encode()
+        )
+        recorded = _record_resume_receipt(args.run_id, tid, receipt)
+        record["phase"] = "receipted"
+        _write_phase_record(path, record)
+        custody.close()
+        record["phase"] = "complete"
+        _write_phase_record(path, record)
+        results.append({
+            "transaction_id": tid,
+            "action": "resumed-receipt" if recorded else "receipt-already-present",
+            "artifact_outcome": artifact["outcome"],
+            "canonical_ignored_state_preserved": artifact["canonical_ignored_state_preserved"],
+        })
+    # Orphan custody debris (crash during capture, before the phase record was
+    # durable) lives only under the controller-private jobs directory and holds
+    # copies, never originals. Reference-counted removal is safe.
+    orphans = []
+    for name in sorted(os.listdir(jobs)):
+        candidate = os.path.join(jobs, name)
+        if name.startswith("artifact-policy-custody-") and candidate not in referenced_roots:
+            shutil.rmtree(candidate, ignore_errors=True)
+            orphans.append(name)
+    released = False
+    with locked_manifest(args.run_id) as doc:
