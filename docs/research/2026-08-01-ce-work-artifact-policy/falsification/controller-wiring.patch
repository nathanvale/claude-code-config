+def _record_resume_receipt(run_id: str, transaction_id: str, receipt: dict) -> bool:
+    """Idempotently record a resume receipt: exactly one receipt per transaction."""
+    with locked_manifest(run_id, write=True) as doc:
+        if any(v.get("attempt_id") == transaction_id for v in doc.get("verifications", [])):
+            return False
+        attempts = plan_wide_verification_attempts(doc)
+        matches = [a for a in attempts if a.get("attempt_id") == transaction_id]
+        doc.setdefault("verifications", []).append(receipt)
+        if matches:
+            matches[0].update({
+                "status": "receipt-recorded",
+                "completed_at": now_iso(),
+                "evidence_digest": receipt["evidence_digest"],
+            })
+        doc["blockers"].append({
+            "at": now_iso(),
+            "unit_id": None,
+            "reason": "plan-wide verification interrupted; artifact state settled on resume, verification result unknown and must re-run",
+            "attempt_id": transaction_id,
+        })
+        event(doc, "artifact-resume-receipt", None, {"attempt_id": transaction_id})
+    return True
+
