{
  "contract": "browser-use.runbook",
  "schema_version": "2",
  "service_id": "fasttrack",
  "flow_id": "login",
  "flow_name": "login",
  "version": "1",
  "summary": "Sign in to the FastTrack candidate portal. Credentials resolve through the Browser Authentication Transaction by binding slug; this file never carries a secret, endpoint, or vault identifier. Chain fill-week after a confirmed sign-in.",
  "allowed_origins": [
    "https://manpowergroup.fasttrack360.com.au"
  ],
  "auth_context_ref": "interactive-login",
  "inputs": [],
  "steps": [
    {
      "kind": "open",
      "url": "https://manpowergroup.fasttrack360.com.au/RecruitmentManager/CandidatePortal",
      "postcondition": {
        "kind": "url-equals",
        "url": "https://manpowergroup.fasttrack360.com.au/RecruitmentManager/CandidatePortal"
      }
    },
    {
      "kind": "snapshot",
      "interactive": true
    },
    {
      "kind": "fill",
      "target": {
        "role": "textbox",
        "name": "Username"
      },
      "sensitivity": "confidential",
      "item_binding": "fasttrack_username",
      "postcondition": {
        "kind": "element-visible",
        "selector": "input[type=password]"
      }
    },
    {
      "kind": "snapshot",
      "interactive": true
    },
    {
      "kind": "fill",
      "target": {
        "role": "textbox",
        "name": "Password"
      },
      "sensitivity": "confidential",
      "item_binding": "fasttrack_password",
      "postcondition": {
        "kind": "element-visible",
        "selector": "input[type=password]"
      }
    },
    {
      "kind": "snapshot",
      "interactive": true
    },
    {
      "kind": "click",
      "target": {
        "role": "button",
        "name": "Sign In"
      },
      "postcondition": {
        "kind": "element-visible",
        "selector": "ul.nav.nav-tabs.top-3"
      }
    }
  ]
}
