{
  "contract": "browser-use.runbook",
  "schema_version": "2",
  "service_id": "fasttrack",
  "flow_id": "fill-week",
  "flow_name": "fill-week",
  "version": "2",
  "summary": "Fill and verify one FastTrack week, then save it as a draft. Final Submit stays human-controlled.",
  "allowed_origins": [
    "https://manpowergroup.fasttrack360.com.au"
  ],
  "auth_context_ref": "interactive-login",
  "inputs": [
    {
      "id": "timesheet_run",
      "summary": "The selected week, expected hours, and FastTrack row values.",
      "required": true,
      "schema": {
        "kind": "object",
        "fields": {
          "envelope": {
            "required": true,
            "schema": {
              "kind": "object",
              "fields": {
                "target_account": {
                  "required": true,
                  "schema": {
                    "kind": "string",
                    "min_length": 1,
                    "max_length": 256
                  }
                },
                "period_start": {
                  "required": true,
                  "schema": {
                    "kind": "date"
                  }
                },
                "period_end": {
                  "required": true,
                  "schema": {
                    "kind": "date"
                  }
                },
                "selected_work_dates": {
                  "required": true,
                  "schema": {
                    "kind": "array",
                    "min_items": 1,
                    "max_items": 31,
                    "items": {
                      "kind": "date"
                    }
                  }
                },
                "expected_aggregate": {
                  "required": true,
                  "schema": {
                    "kind": "object",
                    "fields": {
                      "unit": {
                        "required": true,
                        "schema": {
                          "kind": "enum",
                          "values": [
                            "hours"
                          ]
                        }
                      },
                      "value": {
                        "required": true,
                        "schema": {
                          "kind": "number",
                          "minimum": 0,
                          "maximum": 168
                        }
                      }
                    }
                  }
                },
                "mutation_mode": {
                  "required": true,
                  "schema": {
                    "kind": "enum",
                    "values": [
                      "prepare-draft"
                    ]
                  }
                },
                "final_action": {
                  "required": true,
                  "schema": {
                    "kind": "enum",
                    "values": [
                      "human-submit"
                    ]
                  }
                }
              }
            }
          },
          "payload": {
            "required": true,
            "schema": {
              "kind": "object",
              "fields": {
                "portal": {
                  "required": true,
                  "schema": {
                    "kind": "enum",
                    "values": [
                      "fasttrack"
                    ]
                  }
                },
                "rows": {
                  "required": true,
                  "schema": {
                    "kind": "array",
                    "min_items": 1,
                    "max_items": 7,
                    "items": {
                      "kind": "object",
                      "fields": {
                        "date": {
                          "required": true,
                          "schema": {
                            "kind": "date"
                          }
                        },
                        "day": {
                          "required": true,
                          "schema": {
                            "kind": "enum",
                            "values": [
                              "Mon",
                              "Tue",
                              "Wed",
                              "Thu",
                              "Fri",
                              "Sat",
                              "Sun"
                            ]
                          }
                        },
                        "start_time": {
                          "required": true,
                          "schema": {
                            "kind": "string",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                          }
                        },
                        "end_time": {
                          "required": true,
                          "schema": {
                            "kind": "string",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                          }
                        },
                        "attendance_type": {
                          "required": true,
                          "schema": {
                            "kind": "enum",
                            "values": [
                              "Standard",
                              "Public Holiday Worked"
                            ]
                          }
                        },
                        "breaks": {
                          "required": false,
                          "schema": {
                            "kind": "array",
                            "max_items": 4,
                            "items": {
                              "kind": "object",
                              "fields": {
                                "start_time": {
                                  "required": true,
                                  "schema": {
                                    "kind": "string",
                                    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                                  }
                                },
                                "end_time": {
                                  "required": true,
                                  "schema": {
                                    "kind": "string",
                                    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "kind": "open",
      "url": "https://manpowergroup.fasttrack360.com.au/RecruitmentManager/CandidatePortal#/VGltZUFuZEF0dGVuZGFuY2U00",
      "postcondition": {
        "kind": "url-starts-with",
        "url": "https://manpowergroup.fasttrack360.com.au/RecruitmentManager/CandidatePortal#/VGltZUFuZEF0dGVuZGFuY2U00"
      }
    },
    {
      "kind": "snapshot",
      "interactive": false
    },
    {
      "kind": "action",
      "action_id": "fasttrack-fill-week",
      "expected_digest": "f9df669f19812f1276b4d8f06bb465db50ceabf4c370f2e9955d3d8f44989342",
      "inputs": {
        "week_start": "{{timesheet_run.envelope.period_start}}",
        "week_end": "{{timesheet_run.envelope.period_end}}",
        "rows": "{{timesheet_run.payload.rows}}"
      }
    },
    {
      "kind": "snapshot",
      "interactive": false
    },
    {
      "kind": "action",
      "action_id": "fasttrack-verify-filled-week",
      "expected_digest": "222b054ab8ed925d4736ff9e8835850f21fbbd0a1ff0edc406296f098419a962",
      "inputs": {
        "week_start": "{{timesheet_run.envelope.period_start}}",
        "week_end": "{{timesheet_run.envelope.period_end}}",
        "rows": "{{timesheet_run.payload.rows}}"
      }
    },
    {
      "kind": "snapshot",
      "interactive": false
    },
    {
      "kind": "action",
      "action_id": "fasttrack-save-draft",
      "expected_digest": "c2dcba17260bd3be6e4af42712203d3d0515ee3186f6f95cbbc6deb8e411df4e",
      "inputs": {
        "week_start": "{{timesheet_run.envelope.period_start}}",
        "week_end": "{{timesheet_run.envelope.period_end}}"
      }
    },
    {
      "kind": "snapshot",
      "interactive": false
    },
    {
      "kind": "action",
      "action_id": "fasttrack-verify-saved-draft",
      "expected_digest": "4e6320f72fe70563e57328e0912bbe93275071a107c05f69234ecf71c87fa020",
      "inputs": {
        "week_start": "{{timesheet_run.envelope.period_start}}",
        "week_end": "{{timesheet_run.envelope.period_end}}",
        "rows": "{{timesheet_run.payload.rows}}",
        "expected_total_hours": "{{timesheet_run.envelope.expected_aggregate.value}}"
      }
    }
  ]
}
