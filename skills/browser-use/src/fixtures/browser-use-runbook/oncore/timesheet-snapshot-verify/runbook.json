{
  "contract": "browser-use.runbook",
  "schema_version": "1",
  "service_id": "oncore",
  "flow_id": "timesheet-snapshot-verify",
  "flow_name": "verify-timesheet-loaded",
  "version": "1",
  "summary": "Read-only Oncore proof: navigate to the timesheet portal, observe fresh structure, and verify the timesheet surface is present. Dispatches no mutation.",
  "allowed_origins": ["https://oncoreservices.expr365.com.au"],
  "auth_context_ref": "oncore-portal-session",
  "inputs": [
    {
      "id": "week_ending",
      "summary": "ISO week-ending date the verification targets.",
      "required": false,
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
    }
  ],
  "steps": [
    {
      "kind": "open",
      "url": "https://oncoreservices.expr365.com.au/timesheets",
      "postcondition": {
        "kind": "url-equals",
        "url": "https://oncoreservices.expr365.com.au/timesheets"
      }
    },
    { "kind": "snapshot", "interactive": true }
  ]
}
