{
	"name": "browser-use-scripts",
	"version": "0.1.0",
	"private": false,
	"description": "Browser automation command adapters for warm Chrome and browser target routing.",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"tag": "next"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"bin": {
		"browser-use": "dist/browser-use.js"
	},
	"setup": {
		"pathBin": {
			"browser-use": "./src/browser-use-bun-preflight.ts"
		}
	},
	"scripts": {
		"build": "bun run src/build-dist.ts",
		"browser-use": "./src/browser-use.ts",
		"acceptance:live": "bun run src/browser-use-live-acceptance.ts",
		"pack:dry-run": "bun pm pack --dry-run",
		"prepack": "bun run build",
		"prototype:agent-browser-vertical-slice": "bun run src/prototype-agent-browser-vertical-slice/prototype.ts",
		"prototype:generic-login-engine": "bun run src/prototypes/2026-08-02-generic-login-engine-acceptance/spike.ts",
		"prototype:auth-context-generic-login-route": "bun run src/prototypes/2026-08-02-auth-context-generic-login-route/spike.ts",
		"prototype:runbook-crud-contract": "bun run src/prototypes/2026-08-02-runbook-crud-cli-contract/prototype.ts",
		"prototype:runbook-document-authoring": "bun run src/prototypes/2026-08-02-runbook-document-authoring-contract/prototype.ts",
		"prototype:runbook-generation-activation": "bun run src/prototypes/2026-08-02-runbook-generation-activation-contract/prototype.ts",
		"prototype:reviewed-action-authoring": "bun run src/prototypes/2026-08-02-reviewed-action-authoring-contract/prototype.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@side-quest/browser-connect": "0.1.0",
		"@side-quest/browser-use-security": "0.1.0",
		"@side-quest/cli-command-facade": "0.1.0",
		"@side-quest/mcporter-transport": "0.1.0",
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	}
}
