#!/bin/bash
# pre-commit hook: block commits that would introduce prompt-system drift.
# Only fires when staged changes touch prompt-system files.
#
# Install with: ./scripts/install-git-hooks.sh

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
RENDER_SCRIPT="${REPO_ROOT}/scripts/render-user-prompts.sh"

PROMPT_SYSTEM_PATHS=(
  "prompt-fragments/"
  "rules/"
  "context/"
  "scripts/render-user-prompts.sh"
  "AGENTS.md"
  "CLAUDE.md"
  "generated/"
)

staged=$(git diff --cached --name-only --diff-filter=ACM)

matches=false
for path in $staged; do
  for pattern in "${PROMPT_SYSTEM_PATHS[@]}"; do
    case "${path}" in
      "${pattern}"*|"${pattern}")
        matches=true
        break 2
        ;;
    esac
  done
done

if ! $matches; then
  exit 0
fi

if ! "${RENDER_SCRIPT}" --check > /tmp/prompt-drift-check.log 2>&1; then
  echo ""
  echo "❌ Prompt system drift detected — commit blocked."
  echo ""
  grep -E "^(DRIFT|BROKEN|HYGIENE|ORPHAN):" /tmp/prompt-drift-check.log || cat /tmp/prompt-drift-check.log
  echo ""
  echo "Fix: ${RENDER_SCRIPT} --write"
  echo "Then stage the re-rendered files and retry the commit."
  echo ""
  echo "(Full log: /tmp/prompt-drift-check.log)"
  exit 1
fi

exit 0
