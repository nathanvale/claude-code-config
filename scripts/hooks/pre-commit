#!/bin/bash
# pre-commit hook: block commits that would break instruction health.
# Only fires when staged changes touch instruction files.
#
# Install with: ./scripts/install-git-hooks.sh

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECK_SCRIPT="${REPO_ROOT}/scripts/agent-instructions.sh"

PROMPT_SYSTEM_PATHS=(
  "rules/"
  "context/"
  "scripts/agent-instructions.sh"
  "scripts/render-user-prompts.sh"
  "AGENTS.md"
  "CLAUDE.md"
  "docs/adr/"
  "skills/"
)

staged=$(git diff --cached --name-only --diff-filter=ACDM)

matches=false
for path in $staged; do
  for pattern in "${PROMPT_SYSTEM_PATHS[@]}"; do
    case "${path}" in
      "${pattern}"*|"${pattern}")
        matches=true
        break 2
        ;;
    esac
  done
done

if ! $matches; then
  exit 0
fi

if ! bash "${CHECK_SCRIPT}" check > /tmp/prompt-drift-check.log 2>&1; then
  echo ""
  echo "Instruction health check failed - commit blocked."
  echo ""
  grep -E "^(FAIL|WARN):" /tmp/prompt-drift-check.log || cat /tmp/prompt-drift-check.log
  echo ""
  echo "Fix the reported instruction health issue, then retry the commit."
  echo ""
  echo "(Full log: /tmp/prompt-drift-check.log)"
  exit 1
fi

exit 0
