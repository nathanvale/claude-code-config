{
  "name": "claude-code-config",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "runners/*",
      "runtime/*",
      "skills/browser-use",
      "skills/classic-cinema",
      "skills/cli-execution-auditor",
      "skills/coding-task-tracker",
      "skills/cli-author",
      "skills/fallow",
      "skills/record-decision",
      "skills/skill-feedback",
      "skills/test-runner",
      "skills/worktree",
      "skills/browser-use/src/prototype-playwright-vocab-map"
    ],
    "catalog": {
      "@types/bun": "1.3.14",
      "@types/node": "25.9.1",
      "typescript": "6.0.3"
    }
  },
  "scripts": {
    "biome:check": "biome check --diagnostic-level=error .",
    "biome:fix": "biome check --write .",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint --diagnostic-level=error .",
    "check:workspace-facade": "bun --filter browser-use-scripts build && bun run scripts/check-workspace-facade-invariants.ts",
    "command-entrypoint:integration": "bun test scripts/command-entrypoint.integration.test.ts",
    "foundry-dx": "node runners/foundry-dx/src/foundry-dx.mjs",
    "test:foundry-dx": "bun run --filter @side-quest/foundry-dx test",
    "prove:skills-publisher": "bun run scripts/prove-skills-publisher.ts",
    "prove:workspace-portability": "bun run scripts/prove-workspace-portability.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.3.14"
  },
  "dependencies": {
    "@logtape/logtape": "^2.1.1",
    "@side-quest/cli-command-facade": "workspace:*",
    "@puppeteer/replay": "4.0.2",
    "puppeteer-core": "25.1.0"
  }
}
