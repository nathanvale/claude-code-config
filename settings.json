{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Bash(rm -rf /tmp/**)",
      "Bash(rm -rf /private/tmp/**)",
      "Bash(rm -rf /var/folders/**)",
      "Bash(rm -fr /tmp/**)",
      "Bash(rm -fr /private/tmp/**)",
      "Bash(rm -fr /var/folders/**)"
    ],
    "deny": [],
    "ask": [
      "Bash(git rebase:*)",
      "Bash(git stash drop:*)",
      "Bash(git branch -D:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git reset HEAD~:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fx:*)",
      "Bash(git checkout -- :*)",
      "Bash(git checkout .:*)",
      "Bash(git restore --staged:*)",
      "Bash(git restore .:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git checkout * -- :*)",
      "Bash(git restore --source:*)",
      "Bash(git restore --worktree:*)"
    ],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": true,
  "disabledMcpjsonServers": [],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOME/.claude/hooks/git/git-context-loader.ts",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "date '+Current datetime: %A, %d %B %Y %I:%M %p %Z'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOME/.claude/hooks/git/command-logger.ts",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOME/.claude/hooks/biome/biome-check.ts",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*biome-runner__(biome_lintCheck|biome_lintFix|biome_formatCheck)",
        "hooks": [
          {
            "type": "command",
            "command": "SQ_HOOK_DEDUP_ENABLED=1 bunx @side-quest/claude-hooks posttool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*biome-runner__(biome_lintCheck|biome_lintFix|biome_formatCheck)",
        "hooks": [
          {
            "type": "command",
            "command": "SQ_HOOK_DEDUP_ENABLED=1 bunx @side-quest/claude-hooks posttool-failure",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOME/.claude/hooks/git/session-summary.ts",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOME/.claude/hooks/skill-feedback-stop.ts",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'repo=$(git rev-parse --show-toplevel 2>/dev/null || true); if [ -x \"$repo/scripts/check-prompt-drift-on-stop.sh\" ]; then \"$repo/scripts/check-prompt-drift-on-stop.sh\"; fi'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOME/.claude/hooks/biome/biome-ci.ts",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/nathanvale/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": false,
    "document-skills@anthropic-agent-skills": false,
    "frontend-design@claude-code-plugins": true,
    "imessage@side-quest-engineering": false,
    "unifi-admin@side-quest-engineering": false,
    "contacts-hygiene@side-quest-engineering": false,
    "browser-automation@side-quest-engineering": false,
    "compound-engineering@every-marketplace": true,
    "bitbucket-pr@side-quest-engineering": true,
    "memory-os@side-quest-engineering": false,
    "playground@claude-plugins-official": false,
    "explanatory-output-style@claude-code-plugins": false,
    "microsoft-docs@claude-plugins-official": false,
    "superwhisper@superwhisper": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "superwhisper": {
      "source": {
        "source": "github",
        "repo": "superultrainc/superwhisper-claude-code"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true
}
