<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Approval Broker entitlements (ADR 0027 / ADR 0028, plan R20).

	  The broker owns a device-bound, non-exportable signing key in the Secure
	  Enclave and gates create/expand/replace/revoke behind Touch ID user
	  presence. It receives no OP token, no raw credential, and no browser
	  channel, so it holds NO network entitlement and NO OP-token keychain group.
	  Its only keychain-access-group is its own private
	  group scoped to the signing key and issued Human Identity Attestations.
	-->
	<!--
	  No App Sandbox: select-binding launches the separately signed local
	  environment-auth supervisor, whose token custody root is outside an app
	  container. The broker receives only its secret-free response and never
	  receives the token, raw item bytes, or a browser channel.
	-->
	<!--
	  Private keychain access group for the device-bound signing key only. Not
	  the token-retrieval group: the broker never touches the OP token item.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
