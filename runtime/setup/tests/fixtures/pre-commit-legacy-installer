#!/bin/bash
# pre-commit hook: block commits that would break instruction health.
# Only fires when staged changes touch instruction files.
#
# Install with: ./scripts/install-git-hooks.sh

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECK_SCRIPT="${REPO_ROOT}/scripts/agent-instructions.sh"
CHECK_LOG="${PROMPT_DRIFT_CHECK_LOG:-/tmp/prompt-drift-check.log}"

PROMPT_SYSTEM_PATHS=(
  "rules/"
  "context/"
  "scripts/agent-instructions.sh"
  "scripts/hooks/"
  "scripts/render-user-prompts.sh"
  "AGENTS.md"
  "CLAUDE.md"
  "docs/adr/"
  "skills/"
)

staged=$(git diff --cached --name-only --diff-filter=ACDM)

matches=false
for path in $staged; do
  for pattern in "${PROMPT_SYSTEM_PATHS[@]}"; do
    case "${path}" in
      "${pattern}"*|"${pattern}")
        matches=true
        break 2
        ;;
    esac
  done
done

if ! $matches; then
  exit 0
fi

{
  bash "${CHECK_SCRIPT}" check > "${CHECK_LOG}" 2>&1 &
  check_pid=$!
  wait "${check_pid}"
  check_status=$?
} 2>> "${CHECK_LOG}"

if [[ "${check_status}" -eq 0 ]]; then
  exit 0
fi

if [[ "${check_status}" -eq 137 ]]; then
  echo ""
  echo "Instruction health check was killed by SIGKILL - commit allowed."
  echo ""
  echo "Run directly to verify health outside the commit subprocess:"
  echo "  bash scripts/agent-instructions.sh check"
  echo ""
  echo "(Full log: ${CHECK_LOG})"
  exit 0
fi

  echo ""
  echo "Instruction health check failed - commit blocked."
  echo "Exit code: ${check_status}"
  echo ""
  grep -E "^(FAIL|WARN):" "${CHECK_LOG}" || cat "${CHECK_LOG}"
  echo ""
  echo "Fix the reported instruction health issue, then retry the commit."
  echo ""
  echo "(Full log: ${CHECK_LOG})"
  exit 1
