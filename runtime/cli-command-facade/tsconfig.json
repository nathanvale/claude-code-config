{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"types": ["node"],
		"skipLibCheck": true,
		"ignoreDeprecations": "5.0"
	},
	"include": ["src/**/*.ts"]
}
