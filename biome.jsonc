{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		// Keep the first install lint-focused. The repo has substantial
		// pre-existing formatter drift and a mustache-style HTML template that
		// Biome's HTML parser treats as syntax errors.
		"ignoreUnknown": true,
		"includes": ["**", "!skills/classic-cinema/references/assets/ticket-template.html"]
	},
	"formatter": {
		"enabled": false,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": false,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
